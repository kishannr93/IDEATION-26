# ==============================================================================
# IDEATION 2026 - Production Environment Variables Example
# ==============================================================================
# Copy this file to .env.local for local testing, or populate in Vercel Project Settings.
# DO NOT COMMIT REAL PRODUCTION SECRETS OR PASSWORDS TO SOURCE CONTROL.

# ------------------------------------------------------------------------------
# 1. APPLICATION & DOMAIN CONFIGURATION
# ------------------------------------------------------------------------------
# Full URL where the app is publicly hosted (e.g. https://ideation2026.bietdvg.edu or https://ideation2026.vercel.app)
VITE_APP_URL="https://your-domain.com"
APP_URL="https://your-domain.com"

# ------------------------------------------------------------------------------
# 2. SUPABASE POSTGRESQL & STORAGE (PRODUCTION DATABASE)
# ------------------------------------------------------------------------------
# Found in Supabase Project Settings -> API
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-jwt-key"

# Service role key (used only in secure backend scripts or serverless API routes, never exposed to client)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret"

# ------------------------------------------------------------------------------
# 3. OFFICIAL ORGANIZER & ADMIN SECURITY
# ------------------------------------------------------------------------------
# Designated official administrator email for IDEATION 2026
VITE_ADMIN_EMAIL="gouthamga88@gmail.com"

# High-entropy admin security code / passkey
VITE_ADMIN_SECURITY_CODE="your-strong-admin-passkey"

# ------------------------------------------------------------------------------
# 4. PAYMENT GATEWAY (UPI & BANKING)
# ------------------------------------------------------------------------------
# Official UPI Virtual Payment Address (VPA) for ₹100 team registrations
VITE_UPI_ID="anveshan.biet@upi"
VITE_UPI_PAYEE_NAME="Anveshan Club BIET"

# ------------------------------------------------------------------------------
# 5. TRANSACTIONAL EMAIL (RESEND)
# ------------------------------------------------------------------------------
# Resend API key for dispatching pass generation and verification confirmations
RESEND_API_KEY="re_123456789_abcdefghijklmnopqrstuvwxyz"
EMAIL_FROM="IDEATION 2026 <no-reply@your-verified-domain.com>"
EMAIL_REPLY_TO="anveshan@bietdvg.edu"

# ------------------------------------------------------------------------------
# 6. OPTIONAL PRIVACY-FRIENDLY ANALYTICS & MONITORING
# ------------------------------------------------------------------------------
# Plausible domain or Google Analytics 4 Measurement ID (leave blank to disable)
VITE_ANALYTICS_ID=""
VITE_SENTRY_DSN=""

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isValidSectionId(sectionId) {
      return sectionId in ['rules', 'schedule', 'tracks', 'prizes', 'faqs'];
    }

    function isValidSiteContent(data) {
      return data.keys().hasAll(['section', 'items', 'updatedAt'])
        && data.keys().hasOnly(['section', 'items', 'updatedAt'])
        && data.section is string
        && isValidSectionId(data.section)
        && data.items is list
        && data.items.size() <= 200
        && data.updatedAt is string
        && data.updatedAt.size() >= 10
        && data.updatedAt.size() <= 64;
    }

    match /teams/{teamId} {
      allow read: if true;
      allow create: if request.resource.data.id is string
                    && request.resource.data.teamName is string
                    && request.resource.data.leaderEmail is string;
      allow update: if true;
      allow delete: if false;
    }
    match /site_config/{configId} {
      allow read: if true;
      allow write: if true;
    }
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if true;
    }
    match /core_team/{memberId} {
      allow read: if true;
      allow write: if true;
    }
    match /site_content/{sectionId} {
      allow read: if true;
      allow create, update: if isValidSectionId(sectionId)
                            && isValidSiteContent(request.resource.data)
                            && request.resource.data.section == sectionId;
      allow delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

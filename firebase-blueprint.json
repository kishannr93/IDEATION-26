{
  "entities": {
    "Team": {
      "title": "Registered Team",
      "description": "Hackathon registration record containing team metadata, college, tracks, and payment details.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique registration ID (e.g. IDN-0001)" },
        "teamName": { "type": "string", "description": "Name of the participating team" },
        "college": { "type": "string", "description": "College or university name" },
        "city": { "type": "string", "description": "City of the institution" },
        "department": { "type": "string", "description": "Department or faculty" },
        "course": { "type": "string", "description": "Academic program enrolled in" },
        "primaryTrack": { "type": "string", "description": "Selected primary hackathon track" },
        "backupTrack": { "type": "string", "description": "Alternative backup track" },
        "ideaTitle": { "type": "string", "description": "Proposed solution title" },
        "ideaSummary": { "type": "string", "description": "Problem and solution abstract" },
        "paymentStatus": { "type": "string", "enum": ["Pending", "Verified", "Rejected"], "description": "Verification state of registration fee" },
        "paymentTransactionId": { "type": "string", "description": "UPI UTR reference number" },
        "paymentRemarks": { "type": "string", "description": "Admin review comments" },
        "registeredAt": { "type": "string", "description": "ISO timestamp of submission" },
        "checkedIn": { "type": "boolean", "description": "On-site arrival status" },
        "checkedInAt": { "type": "string", "description": "Check-in timestamp" },
        "leaderEmail": { "type": "string", "format": "email", "description": "Unique email of the team leader" },
        "leaderPhone": { "type": "string", "description": "Mobile number of team leader" },
        "memberEmails": { "type": "string", "description": "Comma-separated or indexed list of member emails for uniqueness checks" },
        "members": { "type": "string", "description": "JSON serialized team members list" }
      },
      "required": ["id", "teamName", "college", "primaryTrack", "paymentStatus", "registeredAt", "leaderEmail"]
    }
  },
  "firestore": {
    "/teams/{teamId}": {
      "schema": "Team",
      "description": "Collection of all registered teams accessible across laptops, mobiles, and online platforms"
    }
  }
}
